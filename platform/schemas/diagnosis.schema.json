{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Deployment diagnosis",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "failure_class", "evidence", "user_action_needed"],
  "properties": {
    "summary": { "type": "string", "maxLength": 600, "description": "In the user's language." },
    "failure_class": { "enum": ["F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "PLATFORM", "UNKNOWN"] },
    "probable_cause": { "type": "string", "maxLength": 400 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "line", "why"],
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "why": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "user_action_needed": { "type": "boolean" },
    "user_action": { "type": "string", "maxLength": 400 },
    "suggested_change_request": { "type": "string", "maxLength": 200, "description": "A natural-language request the user can send to change, e.g. 'api 메모리를 M으로 올려줘'." },
    "missing_evidence": { "type": "string", "maxLength": 300, "description": "When UNKNOWN: what would decide it." }
  }
}
