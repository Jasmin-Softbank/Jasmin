{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Jasmin workload spec v0 (.jasmin/jasmin.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "app",
    "services"
  ],
  "properties": {
    "apiVersion": {
      "const": "jasmin/v0"
    },
    "app": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,28}[a-z0-9]$"
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/service"
      },
      "contains": {
        "required": [
          "route"
        ]
      }
    },
    "egress": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "description": "External HTTPS hosts the code calls at runtime (TCP 443 only). All other outbound traffic is denied.",
      "items": {
        "type": "string",
        "pattern": "^(\\*\\.)?([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size"
          ],
          "properties": {
            "size": {
              "enum": [
                "small"
              ]
            }
          }
        },
        "bucket": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "public_read": {
              "const": false
            }
          }
        }
      }
    }
  },
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "build",
        "port"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,19}$"
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dockerfile"
          ],
          "properties": {
            "context": {
              "type": "string"
            },
            "dockerfile": {
              "type": "string"
            }
          }
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "health": {
          "type": "string",
          "pattern": "^/"
        },
        "route": {
          "type": "string",
          "pattern": "^/",
          "description": "Path prefix on the app host. Omit for internal services."
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20
        },
        "migrate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command"
          ],
          "description": "Runs before each rollout as an Argo CD Sync hook Job (wave 1, after the DB) with the same image and MIGRATION_DATABASE_URL.",
          "properties": {
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "maxItems": 20
            }
          }
        },
        "env": {
          "type": "object",
          "maxProperties": 50,
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "secrets": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          }
        },
        "size": {
          "enum": [
            "S",
            "M",
            "L"
          ]
        },
        "strategy": {
          "enum": [
            "rolling",
            "canary",
            "bluegreen"
          ],
          "description": "Default rolling. canary/bluegreen render an Argo Rollouts Rollout."
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    }
  }
}
