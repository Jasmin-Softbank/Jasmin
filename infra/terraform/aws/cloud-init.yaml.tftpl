#cloud-config
# Public configuration only; this content is visible in Terraform state and VM metadata.
package_update: true
packages: [python3-venv, git, e2fsprogs]
write_files:
  - path: /etc/railshot/node.yml
    permissions: "0600"
    content: |
      ${indent(6, node_config)}
  - path: /usr/local/sbin/railshot-bootstrap
    permissions: "0700"
    content: |
      ${indent(6, bootstrap_script)}
  - path: /etc/railshot/bootstrap-manifest.json
    permissions: "0600"
    content: ${jsonencode(bootstrap_manifest)}
  - path: /etc/systemd/system/k3s.service.d/data-disk.conf
    permissions: "0644"
    content: |
      [Unit]
      RequiresMountsFor=/var/lib/rancher
runcmd:
  - [bash, /usr/local/sbin/railshot-bootstrap]
