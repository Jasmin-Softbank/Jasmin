apiVersion: v1
kind: Namespace
metadata:
  name: argocd
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: argo-cd
  namespace: kube-system
spec:
  repo: https://argoproj.github.io/argo-helm
  chart: argo-cd
  version: 10.9.4
  targetNamespace: argocd
  valuesContent: |-
    dex:
      enabled: false
    notifications:
      enabled: false
    configs:
      cm:
        timeout.reconciliation: 60s
        resource.customizations.health.argoproj.io_Application: |
          hs = {status = "Progressing", message = "Waiting for child sync and health"}
          if obj.status ~= nil then
            if obj.status.health ~= nil then
              hs.message = obj.status.health.message or hs.message
              if obj.status.health.status == "Degraded" then hs.status = "Degraded" end
              if obj.status.health.status == "Healthy" and obj.status.sync ~= nil and obj.status.sync.status == "Synced" then
                hs.status = "Healthy"
              end
            end
          end
          return hs
      params:
        applicationsetcontroller.enable.policy.override: true   # lets tenant-apps use create-update
    server:
      service:
        type: ClusterIP
