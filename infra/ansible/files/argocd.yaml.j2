apiVersion: v1
kind: Namespace
metadata:
  name: argocd
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: argo-cd
  namespace: kube-system
spec:
  repo: https://argoproj.github.io/argo-helm
  chart: argo-cd
  version: 10.9.4
  targetNamespace: argocd
  valuesContent: |-
    dex:
      enabled: false
    notifications:
      enabled: false
    configs:
      cm:
        timeout.reconciliation: 60s
      params:
        applicationsetcontroller.enable.policy.override: true   # lets tenant-apps use create-update
    server:
      service:
        type: ClusterIP
