apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: cilium
  namespace: kube-system
spec:
  repo: https://helm.cilium.io
  chart: cilium
  version: 1.20.2
  targetNamespace: kube-system
  bootstrap: true   # installs before the cluster has a working CNI
  valuesContent: |-
    operator:
      replicas: 1
    ipam:
      operator:
        clusterPoolIPv4PodCIDRList: ["10.42.0.0/16"]   # k3s default pod CIDR (Cilium k3s guide)
    # k3s runs without kube-proxy; Cilium replaces it, which also serves hostPort (k3s servicelb → Traefik 80/443).
    kubeProxyReplacement: true
    k8sServiceHost: 127.0.0.1   # ponytail: single server node; use the node or LB address when agents join
    k8sServicePort: 6443
    hubble:
      relay:
        enabled: true
