apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: cilium
  namespace: kube-system
spec:
  repo: https://helm.cilium.io
  chart: cilium
  version: 1.20.2
  targetNamespace: kube-system
  bootstrap: true   # installs before the cluster has a working CNI
  valuesContent: |-
    operator:
      replicas: 1
    ipam:
      mode: kubernetes
    hubble:
      relay:
        enabled: true
