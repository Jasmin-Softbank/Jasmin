# k3s bundles Traefik. One way in: the Gateway API provider only, and only routes from tenant namespaces.
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |-
    providers:
      kubernetesGateway:
        enabled: true
      kubernetesIngress:
        enabled: false   # no Ingress / IngressRoute side doors
      kubernetesCRD:
        enabled: false
    gateway:
      enabled: true
      listeners:
        web:
          port: 8000
          protocol: HTTP
          namespacePolicy:
            from: Selector
            selector:
              matchExpressions: [{key: railshot.dev/tenant, operator: Exists}]
    metrics:
      prometheus:
        addRoutersLabels: true
