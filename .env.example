# Copy to .env and fill locally. Never commit real credentials.
CP_API_TOKEN=replace-with-a-long-random-token
# Actual ID for nate2402, not the project name.
CP_PROJECT_ID=replace-with-project-id
CP_PROVIDER_ID=openstack-main
CP_AUTH_URL=https://openstack.example.invalid:5000/v3
CP_AUTH_TYPE=password
CP_USERNAME=replace-with-username
CP_PASSWORD=replace-with-password
CP_USER_DOMAIN_NAME=Default
CP_REGION_NAME=RegionOne
CP_INTERFACE=public
CP_DOCS_ENABLED=false
CP_CONNECT_TIMEOUT=5
CP_READ_TIMEOUT=20
CP_READY_TIMEOUT=3
# CP_CA_CERT=/absolute/path/to/ca.pem
# For application credentials, remove username/password/user-domain above:
# CP_AUTH_TYPE=application_credential
# CP_APPLICATION_CREDENTIAL_ID=replace-with-id
# CP_APPLICATION_CREDENTIAL_SECRET=replace-with-secret
